# ─────────────────────────────────────────────────────
#  TONTINE+ — Variables d'environnement
#  Copier ce fichier : cp .env.example .env
#  Ne JAMAIS committer .env sur GitHub !
# ─────────────────────────────────────────────────────

FLASK_ENV=development

# Sécurité (générer des clés aléatoires en production)
SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
JWT_SECRET_KEY=autre-cle-jwt-differente-et-longue

# Base de données
# SQLite (développement) — rien à changer
# PostgreSQL (production) → décommenter et remplir :
# DATABASE_URL=postgresql://user:password@host:5432/tontine_db

# Wave Sénégal
WAVE_SANDBOX=true
WAVE_API_KEY=wave_sn_test_XXXXXXXXXXXXXXXXXXXXXXXX

# Africa's Talking (SMS)
AFRICAS_TALKING_USER=sandbox
AFRICAS_TALKING_KEY=votre_cle_africas_talking

# Port (Replit / Render / Railway)
PORT=5000
